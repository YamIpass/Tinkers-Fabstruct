{
  "schemaVersion": 1,
  "id": "tconstruct",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Tinkers' Fabstruct is an unofficial Fabric 1.20.1 port of Tinkers' Construct. Java implementation adapted to the Fabric platform; code, data and assets are derived from the MIT-licensed upstream project by SlimeKnights, and bundled Mantle is the MIT-licensed Fabric fork by Alpha-s-Stuff. Not affiliated with or endorsed by SlimeKnights.",
  "authors": [
    "SlimeKnights (original design and content)",
    "Fabric port contributors"
  ],
  "contact": {
    "sources": "https://github.com/SlimeKnights/TinkersConstruct"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "jei_mod_plugin": [
      "slimeknights.tconstruct.plugin.jei.JEIPlugin"
    ],
    "main": [
      "slimeknights.tconstruct.TConstruct"
    ],
    "client": [
      "slimeknights.tconstruct.client.TinkerClient"
    ],
    "cardinal-components": [
      "slimeknights.tconstruct.gadgets.capability.PiggybackCapability",
      "slimeknights.tconstruct.tools.logic.EquipmentChangeWatcher",
      "slimeknights.tconstruct.library.tools.capability.TinkerDataCapability",
      "slimeknights.tconstruct.library.tools.capability.PersistentDataCapability",
      "slimeknights.tconstruct.library.tools.capability.EntityModifierCapability"
    ]
  },
  "custom": {
    "cardinal-components": [
      "tconstruct:piggyback",
      "tconstruct:modifier_data",
      "tconstruct:persistent_data",
      "tconstruct:equipment_watcher",
      "tconstruct:modifiers"
    ]
  },
  "mixins": [
    "tconstruct.mixins.json"
  ],
  "accessWidener": "tconstruct.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
